# Copy to .env, which Git ignores. Never commit a real key.

# fake costs nothing. real calls Claude and needs ANTHROPIC_API_KEY.
LLM_GATEWAY_MODE=fake
ANTHROPIC_API_KEY=

# llm-gateway refuses calls once this much is spent in a UTC day.
LLM_DAILY_LIMIT_USD=15

LLM_GATEWAY_TOKEN=local-dev-token
POSTGRES_PASSWORD=local-dev-password
LLM_DB_PASSWORD=local-dev-password
